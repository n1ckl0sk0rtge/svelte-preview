<idea-plugin>
    <id>dev.sveltepreview</id>
    <name>Svelte Preview</name>
    <vendor>Svelte Preview</vendor>
    <description><![CDATA[
        Preview Svelte 5 components beside your editor with typed props, named states,
        independent interactive previews, and live updates. Requires the local svelte-preview npm package.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>JavaScript</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Svelte Preview" anchor="right"
                    factoryClass="dev.sveltepreview.PreviewToolWindowFactory"/>
        <projectConfigurable id="dev.sveltepreview.settings" displayName="Svelte Preview" parentId="tools"
                             instance="dev.sveltepreview.PreviewSettingsConfigurable"/>
    </extensions>
    <actions>
        <action id="dev.sveltepreview.TogglePreview" class="dev.sveltepreview.TogglePreviewAction"
                text="Toggle Svelte Preview" description="Show or hide component previews for this project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift P"/>
        </action>
    </actions>
</idea-plugin>
