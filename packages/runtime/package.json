{
  "name": "svelte-preview",
  "version": "0.1.0",
  "description": "Local component previews for Svelte 5 and JetBrains IDEs",
  "type": "module",
  "bin": { "svelte-preview": "./bin/svelte-preview.mjs" },
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.mjs" } },
  "files": ["bin", "client", "index.mjs", "index.d.ts", "mock-fetch.mjs", "setup.mjs", "setup.d.mts", "server.mjs"],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "peerDependencies": { "svelte": "^5.46.4" },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "sass": "^1.108.2"
  }
}
